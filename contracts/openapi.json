              "VERIFIED",
              "UNVERIFIED",
              "SUSPICIOUS",
              "NOT_APPLICABLE"
            ],
            "title": "Source Authenticity"
          },
          "sender_identity": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "UNVERIFIED",
              "IMPERSONATION_LIKELY",
              "IMPERSONATION_CONFIRMED",
              "NOT_APPLICABLE"
            ],
            "title": "Sender Identity"
          },
          "channel_status": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "UNVERIFIED",
              "SUSPICIOUS",
              "MALICIOUS",
              "NOT_APPLICABLE"
            ],
            "title": "Channel Status"
          },
          "scam_risk": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "UNKNOWN"
