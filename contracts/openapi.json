            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "publisher",
          "title",
          "url",
          "published_at"
        ],
        "title": "SourceView"
      },
      "TextVerificationRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 25000,
            "minLength": 10,
            "title": "Text"
          },
          "question": {
            "type": "string",
            "maxLength": 500,
            "title": "Question",
            "default": "Apakah isi teks ini benar dan aman ditindaklanjuti?"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "sender_context": {
            "type": "string",
            "enum": [
              "NOT_APPLICABLE",
              "UNKNOWN_NUMBER",
              "KNOWN_CONTACT",
              "FORWARDED",
              "SOCIAL_MEDIA",
              "UNKNOWN"
            ],
            "title": "Sender Context",
            "default": "UNKNOWN"
          },
          "page_context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PageContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_mode": {
            "type": "string",
            "enum": [
              "STRUCTURED",
              "NARRATIVE",
              "BOTH"
            ],
            "title": "Output Mode",
            "default": "STRUCTURED"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TextVerificationRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerificationResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "status": {
            "type": "string",
            "const": "COMPLETED",
            "title": "Status"
          },
          "mode": {
            "type": "string",
            "const": "LIVE",
            "title": "Mode"
          },
          "mode_notice": {
            "type": "string",
            "title": "Mode Notice"
          },
          "input_summary": {
            "$ref": "#/components/schemas/InputSummary"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "REFUTED",
              "MISLEADING",
              "PARTLY_TRUE",
              "OUTDATED",
              "UNVERIFIED",
              "SATIRE",
              "OPINION"
            ],
            "title": "Verdict"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "UNKNOWN"
            ],
            "title": "Risk Level"
          },
          "dimensions": {
            "$ref": "#/components/schemas/AssessmentDimensions"
          },
          "headline": {
            "type": "string",
            "title": "Headline"
          },
          "evidence_sufficiency": {
            "type": "number",
            "title": "Evidence Sufficiency"
          },
          "evidence_sufficiency_label": {
            "type": "string",
            "title": "Evidence Sufficiency Label"
          },
          "what_checked": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "What Checked"
          },
          "why": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Why"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "recommended_actions": {
            "items": {
              "$ref": "#/components/schemas/RecommendedAction"
            },
            "type": "array",
            "title": "Recommended Actions"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceView"
            },
            "type": "array",
            "title": "Sources"
          },
          "uncertainty": {
            "type": "string",
            "title": "Uncertainty"
          },
          "requires_human_review": {
            "type": "boolean",
            "title": "Requires Human Review"
          },
          "community_status": {
            "type": "string",
            "enum": [
              "NOT_REQUIRED",
              "ELIGIBLE_WITH_CONSENT"
            ],
            "title": "Community Status"
          },
          "privacy_notice": {
            "type": "string",
            "title": "Privacy Notice"
          },
          "rulebook": {
            "$ref": "#/components/schemas/RulebookTrace"
          },
          "pipeline": {
            "items": {
              "$ref": "#/components/schemas/PipelineStage"
            },
            "type": "array",
            "title": "Pipeline"
          },
          "presentation": {
            "$ref": "#/components/schemas/ResponsePresentation"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "trace_id",
          "status",
          "mode",
          "mode_notice",
          "input_summary",
          "verdict",
          "risk_level",
          "dimensions",
          "headline",
          "evidence_sufficiency",
          "evidence_sufficiency_label",
          "what_checked",
          "why",
          "evidence",
          "recommended_actions",
          "sources",
          "uncertainty",
          "requires_human_review",
          "community_status",
          "privacy_notice",
          "rulebook",
          "pipeline",
          "presentation",
          "disclaimer"
        ],
        "title": "VerificationResponse"
      }
    }
  }
}
