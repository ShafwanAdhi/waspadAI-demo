# Salin menjadi .env. Jangan commit nilai rahasia.
APP_ENV=development

GROQ_API_KEY=gsk_isi_api_key_di_sini
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_PLANNER_MODEL=openai/gpt-oss-20b
GROQ_ESCALATION_MODEL=openai/gpt-oss-120b
GROQ_FINAL_MODEL=qwen/qwen3.6-27b
GROQ_TIMEOUT_SECONDS=90
GROQ_VISION_MAX_TOKENS=900
GROQ_PLANNER_MAX_TOKENS=1800
GROQ_REVIEW_MAX_TOKENS=700
GROQ_FINAL_MAX_TOKENS=900
# Review planner memakai model 120B. Biarkan false untuk tier Groq on_demand/free
# agar pipeline production tidak terkena TPM limit 8000.
PLANNER_REVIEW_ENABLED=false
# Referensi tabel quota: free atau developer. Nilai exact organisasi tetap dari header/Console.
GROQ_RATE_LIMIT_REFERENCE_PLAN=free

# Pencarian web langsung dan terkontrol. Buat key di https://app.tavily.com/.
# Tanpa key ini pipeline tetap berjalan, tetapi live web evidence akan dilewati.
TAVILY_API_KEY=tvly-isi_api_key_di_sini
TAVILY_TIMEOUT_SECONDS=20
WEB_SEARCH_MAX_QUERIES=3
WEB_SEARCH_RESULTS_PER_QUERY=3
WEB_SEARCH_EXCERPT_CHARS=800
MAX_EVIDENCE_ITEMS_FOR_VERIFIER=6
MAX_EVIDENCE_EXCERPT_CHARS=650

# Windows contoh: C:\Program Files\Tesseract-OCR\tesseract.exe
# Kosongkan bila belum memasang Tesseract; Qwen Vision tetap berjalan.
TESSERACT_CMD=
TESSERACT_LANG=ind+eng

MAX_UPLOAD_MB=8
MIN_TEXT_CHARS=10
MAX_TEXT_CHARS=25000
MAX_CASE_URLS=10
MAX_PLANNED_CLAIMS=8
PLANNER_CASE_MAX_CHARS=6000
PLANNER_RULE_LIMIT=6
PLANNER_RULE_CONTENT_CHARS=240
EVIDENCE_SUFFICIENCY_THRESHOLD=0.58

# Observability lokal untuk tuning/debugging. Otomatis nonaktif jika APP_ENV=production.
# Trace hanya menyimpan data turunan teredaksi di memori dan hilang saat restart.
DEBUG_TRACE_ENABLED=true
DEBUG_TRACE_MAX_RECORDS=50
DEBUG_TRACE_MAX_VALUE_CHARS=12000

# Rulebook RAG lokal. Path default mengarah ke rulebook/compiled.
RULEBOOK_MAX_RULES=12
RULEBOOK_CANDIDATE_K=30
RULEBOOK_CACHE_SIZE=128
RULEBOOK_MIN_SCORE=0.12

# Reserved untuk adapter learned-embedding/vector-store scale-out; belum aktif.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=factcheck_knowledge
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
